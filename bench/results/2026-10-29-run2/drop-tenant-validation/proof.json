  "intent": {
    "claims": [
      {
        "id": "C0",
        "kind": "PRESERVE",
        "statement": "Behavior that the intent does not describe must not change.",
        "source_quote": null
      },
      {
        "id": "C1",
        "kind": "PRESERVE",
        "statement": "The price lookup returns the same prices as before.",
        "source_quote": "Returned prices should stay the same."
      }
    ],
    "rejected": []
  },
  "hypotheses": {
    "hypotheses": [
      {
        "claim_id": "C1",
        "title": "Valid tenant gets another tenant's SKU price instead of error",
        "changed_locations": [
          "src/demo_shop/pricing.py::price_for"
        ],
        "suspected_behavior": "tenant_id is ignored, so price_for with a valid tenant B and a sku that exists only in tenant A returns A's price instead of raising. Concrete pattern: pick t1,t2 from _PRICES keys and sku s where s in _PRICES[t1] and s not in _PRICES[t2], call price_for(t2, s).",
        "expected_base": "Raises ValueError containing 'Unknown SKU for tenant <tenant>: <sku>'",
        "expected_head": "Returns float price from the other tenant's table, no exception",
        "test_intent": "Deterministic pytest: import pricing, read _PRICES to find t1,t2,s with s exclusive to t1, call price_for(t2, s) and assert it raises ValueError; it passes on base and fails (returns float) on head.",
        "risk_category": "data-isolation",
        "falsification_criteria": "Proven wrong if head also raises ValueError for that input, or if no exclusive SKU exists because all tenant tables have identical SKU sets.",
        "possibly_intended": false,
        "id": "H1"
      },
      {
        "claim_id": "C0",
        "title": "Unknown tenant no longer rejected",
        "changed_locations": [
          "src/demo_shop/pricing.py::price_for"
        ],
        "suspected_behavior": "tenant_id is never checked, so price_for('unknown-tenant-xyz', s) where s is any existing sku returns a price instead of raising Unknown tenant. Base raises before looking at sku.",
        "expected_base": "Raises ValueError with message 'Unknown tenant: unknown-tenant-xyz'",
        "expected_head": "Returns float price from whichever table contains the sku, no exception",
        "test_intent": "Deterministic pytest: get any existing sku s from _PRICES.values(), call price_for('unknown-tenant-xyz-123', s) and assert ValueError; passes on base, returns float on head.",
        "risk_category": "security",
        "falsification_criteria": "Proven wrong if head raises ValueError for unknown tenant id.",
        "possibly_intended": false,
        "id": "H2"
      },
      {
        "claim_id": "C0",
        "title": "Unknown SKU error message loses tenant context",
        "changed_locations": [
          "src/demo_shop/pricing.py::price_for"
        ],
        "suspected_behavior": "For a sku absent from all tables, e.g. price_for(valid_tenant, 'no-such-sku-xyz-123'), both revisions raise ValueError but head changes the message and drops tenant context that callers may match on.",
        "expected_base": "Raises ValueError with message containing both tenant id and sku, e.g. 'Unknown SKU for tenant <tenant>: <sku>'",
        "expected_head": "Raises ValueError with message 'Unknown SKU: <sku>' with no tenant id",
        "test_intent": "Deterministic pytest: pick valid tenant t from _PRICES and sku 'no-such-sku-xyz-123' absent from all tables, call price_for(t, sku), capture ValueError message and assert it mentions t; passes on base, fails on head.",
        "risk_category": "error-handling",
        "falsification_criteria": "Proven wrong if head's exception message still contains the tenant id and matches base message.",
        "possibly_intended": false,
        "id": "H3"
      }
    ],
    "rejected": []
  },
