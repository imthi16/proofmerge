    "hypotheses": [
      {
        "claim_id": "C0",
        "title": "Negative purchase corrupts ledger before raising",
        "changed_locations": [
          "src/demo_shop/orders.py::record_purchase"
        ],
        "suspected_behavior": "Negative amount mutates ledger before raising: ledger={'alice':100.0}, customer='alice', amount=-10.0 debits ledger to 90.0 then raises.",
        "expected_base": "Raises ValueError for Negative purchase amount and ledger stays {'alice': 100.0}",
        "expected_head": "Raises ValueError for Negative purchase amount but ledger becomes {'alice': 90.0}",
        "test_intent": "Call record_purchase with {'alice':100.0}, 'alice', -10.0, catch ValueError, then assert ledger['alice'] is still 100.0.",
        "risk_category": "state",
        "falsification_criteria": "If head leaves ledger unchanged when raising for negative amount, this hypothesis is wrong.",
        "possibly_intended": false,
        "id": "H1"
      },
      {
        "claim_id": "C0",
        "title": "Swapped validation changes which error wins",
        "changed_locations": [
          "src/demo_shop/orders.py::record_purchase"
        ],
        "suspected_behavior": "Validation order swapped: ledger={}, customer='bob' unknown, amount=-5.0 raises different error message.",
        "expected_base": "Raises ValueError with message containing 'Negative purchase amount'",
        "expected_head": "Raises ValueError with message containing 'Unknown customer'",
        "test_intent": "Call record_purchase with {}, 'bob', -5.0 and assert the ValueError message mentions negative amount vs unknown customer.",
        "risk_category": "error-handling",
        "falsification_criteria": "If head still raises 'Negative purchase amount' for unknown customer with negative amount, this hypothesis is wrong.",
        "possibly_intended": true,
        "id": "H2"
      }
    ],
    "rejected": []
  },
