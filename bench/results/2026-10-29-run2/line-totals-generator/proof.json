{
  "proofmerge_version": "0.1.0",
  "run_id": "line-totals-generator",
  "base_sha": "9dcc10400d16c23a0db4f508c3678ffabf46b1f4",
  "head_sha": "780147d42e25d22383689c96a7af32f62f8e55e7",
  "diff_sha256": "76d2fce7d81c7552c2d72de042af6f617bc9b74e1ea10e5587786fb1f92187e0",
  "intent": {
    "claims": [
      {
        "id": "C0",
        "kind": "PRESERVE",
        "statement": "Behavior that the intent does not describe must not change.",
        "source_quote": null
      }
    ],
    "rejected": []
  },
  "hypotheses": {
    "hypotheses": [
      {
        "claim_id": "C0",
        "title": "line_totals returns generator breaking list equality",
        "changed_locations": [
          "src/demo_shop/orders.py::line_totals"
        ],
        "suspected_behavior": "line_totals([{'qty': 2, 'price': 5}, {'qty': 3, 'price': 5}]) returns a generator instead of a list, so == [10, 15] is False on head but True on base",
        "expected_base": "[10, 15] (a list equal to [10, 15])",
        "expected_head": "generator object that != [10, 15] and is not an instance of list",
        "test_intent": "call line_totals with two items and assert result == [10, 15] and isinstance(result, list)",
        "risk_category": "return-contract",
        "falsification_criteria": "head result equals [10, 15] and isinstance(result, list) is True",
        "possibly_intended": false,
        "id": "H1"
      },
      {
        "claim_id": "C0",
        "title": "line_totals result no longer subscriptable",
        "changed_locations": [
          "src/demo_shop/orders.py::line_totals"
        ],
        "suspected_behavior": "indexing line_totals([{'qty': 2, 'price': 5}])[0] works on base but raises TypeError on head",
        "expected_base": "10 via result[0]",
        "expected_head": "TypeError: 'generator' object is not subscriptable on result[0]",
        "test_intent": "call line_totals with one item and subscript [0], expecting the line total",
        "risk_category": "return-contract",
        "falsification_criteria": "head result supports result[0] == 10",
        "possibly_intended": false,
        "id": "H2"
      },
      {
        "claim_id": "C0",
        "title": "len() on line_totals result raises TypeError",
        "changed_locations": [
          "src/demo_shop/orders.py::line_totals"
        ],
        "suspected_behavior": "len(line_totals([{'qty':1,'price':2},{'qty':2,'price':3}])) returns 2 on base but raises TypeError on head",
        "expected_base": "2 via len(result)",
        "expected_head": "TypeError: object of type 'generator' has no len() on len(result)",
        "test_intent": "call line_totals with two items and call len() on the result",
        "risk_category": "return-contract",
        "falsification_criteria": "len(head result) returns 2",
        "possibly_intended": false,
        "id": "H3"
      },
      {
        "claim_id": "C0",
        "title": "line_totals result exhausts after one iteration",
        "changed_locations": [
          "src/demo_shop/orders.py::line_totals"
        ],
        "suspected_behavior": "storing result = line_totals([{'qty':1,'price':2},{'qty':2,'price':3}]) and iterating twice re-yields values on base but yields empty second time on head",
        "expected_base": "first list(result) == [2, 6] and second list(result) == [2, 6]",
        "expected_head": "first list(result) == [2, 6] but second list(result) == [] (exhausted)",
        "test_intent": "store result once, call list(result) twice and compare both conversions",
        "risk_category": "state",
        "falsification_criteria": "converting head result to list twice yields full values both times",
        "possibly_intended": false,
        "id": "H4"
      },
      {
        "claim_id": "C0",
        "title": "empty input truthiness and equality changes",
        "changed_locations": [
          "src/demo_shop/orders.py::line_totals"
        ],
        "suspected_behavior": "line_totals([]) returns [] (falsy) on base but returns a truthy generator object on head, breaking empty-check and equality",
        "expected_base": "[] which is falsy and == []",
        "expected_head": "generator object which is truthy and != []",
        "test_intent": "call line_totals([]) and assert result == [] and not result",
        "risk_category": "boundary",
        "falsification_criteria": "head line_totals([]) == [] and bool(head result) is False",
        "possibly_intended": false,
        "id": "H5"
      }
    ],
    "rejected": []
  },
