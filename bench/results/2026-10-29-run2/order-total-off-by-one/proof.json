    "hypotheses": [
      {
        "claim_id": "C0",
        "title": "order_total skips last item due to off-by-one range",
        "changed_locations": [
          "src/demo_shop/orders.py::order_total"
        ],
        "suspected_behavior": "Head iterates range(len(items)-1) so last item is never added; with items=[{\"qty\":2,\"price\":10.0},{\"qty\":1,\"price\":5.0}] and shipping='standard' total misses 5.0",
        "expected_base": "30.0 (2*10.0 + 1*5.0 + 5.0 shipping)",
        "expected_head": "25.0 (2*10.0 + 5.0 shipping, last item skipped)",
        "test_intent": "Call order_total([{'qty':2,'price':10.0},{'qty':1,'price':5.0}], shipping='standard') and assert result == 30.0; passes on base, fails on head with 25.0.",
        "risk_category": "boundary",
        "falsification_criteria": "If head returns 30.0 for this input, same as base, the hypothesis is wrong.",
        "possibly_intended": false,
        "id": "H1"
      }
    ],
    "rejected": []
  },
