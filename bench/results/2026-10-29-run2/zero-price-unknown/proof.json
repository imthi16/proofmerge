  "hypotheses": {
    "hypotheses": [
      {
        "claim_id": "C0",
        "title": "Unknown tenant returns 0.0 instead of raising ValueError",
        "changed_locations": [
          "src/demo_shop/pricing.py::price_for"
        ],
        "suspected_behavior": "price_for with unknown tenant (e.g., tenant_id='__unknown_tenant_xyz_12345__', sku='anything') silently returns 0.0 instead of raising ValueError, masking typos and allowing free pricing.",
        "expected_base": "Raises ValueError (message 'Unknown tenant: ...')",
        "expected_head": "Returns 0.0",
        "test_intent": "Pytest test imports price_for and _PRICES, asserts '__unknown_tenant_xyz_12345__' not in _PRICES, then calls price_for('__unknown_tenant_xyz_12345__', 'anything') expecting ValueError on base vs 0.0 on head.",
        "risk_category": "error-handling",
        "falsification_criteria": "Hypothesis is wrong if base for tenant_id='__unknown_tenant_xyz_12345__' does not raise ValueError, or if head for the same input raises ValueError instead of returning 0.0.",
        "possibly_intended": true,
        "id": "H1"
      },
      {
        "claim_id": "C0",
        "title": "Unknown SKU for known tenant returns 0.0 instead of raising ValueError",
        "changed_locations": [
          "src/demo_shop/pricing.py::price_for"
        ],
        "suspected_behavior": "price_for with a valid tenant but unknown SKU (e.g., first key of _PRICES with sku='__unknown_sku_xyz_12345__') silently returns 0.0 instead of raising ValueError.",
        "expected_base": "Raises ValueError (message 'Unknown SKU for tenant ...')",
        "expected_head": "Returns 0.0",
        "test_intent": "Pytest test imports price_for and _PRICES, picks valid_tenant = next(iter(_PRICES)) and asserts '__unknown_sku_xyz_12345__' not in _PRICES[valid_tenant], then calls price_for(valid_tenant, '__unknown_sku_xyz_12345__') expecting ValueError on base vs 0.0 on head.",
        "risk_category": "error-handling",
        "falsification_criteria": "Hypothesis is wrong if base for a valid tenant plus unknown SKU does not raise ValueError, or if head raises ValueError instead of returning 0.0.",
        "possibly_intended": true,
        "id": "H2"
      }
    ],
    "rejected": []
  },
