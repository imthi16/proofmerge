  "intent": {
    "claims": [
      {
        "id": "C0",
        "kind": "PRESERVE",
        "statement": "Behavior that the intent does not describe must not change.",
        "source_quote": null
      },
      {
        "id": "C1",
        "kind": "CHANGE",
        "statement": "apply_coupon performs a single dictionary lookup.",
        "source_quote": "apply_coupon as a single dictionary lookup"
      }
    ],
    "rejected": []
  },
  "hypotheses": {
    "hypotheses": [
      {
        "claim_id": "C0",
        "title": "Case-insensitive coupon lookup lost",
        "changed_locations": [
          "src/demo_shop/cart.py::apply_coupon"
        ],
        "suspected_behavior": "With coupons={'save10': 0.1} and code='SAVE10', base normalizes via casefold() to 'save10' and returns the discount, while head does exact match and rejects the uppercase variant.",
        "expected_base": "returns 0.1",
        "expected_head": "raises ValueError for unknown coupon",
        "test_intent": "Call apply_coupon({'save10': 0.1}, 'SAVE10') on base and head and compare return value versus ValueError.",
        "risk_category": "error-handling",
        "falsification_criteria": "If base with coupons={'save10': 0.1} and code='SAVE10' also raises ValueError instead of returning 0.1, this hypothesis is wrong.",
        "possibly_intended": true,
        "id": "H1"
      },
      {
        "claim_id": "C0",
        "title": "Whitespace-tolerant coupon lookup lost",
        "changed_locations": [
          "src/demo_shop/cart.py::apply_coupon"
        ],
        "suspected_behavior": "With coupons={'save10': 0.1} and code='  save10  ' (leading/trailing spaces), base strips whitespace and returns the discount, while head does exact match and rejects it.",
        "expected_base": "returns 0.1",
        "expected_head": "raises ValueError for unknown coupon",
        "test_intent": "Call apply_coupon({'save10': 0.1}, '  save10  ') on base and head and compare return value versus ValueError.",
        "risk_category": "boundary",
        "falsification_criteria": "If base with coupons={'save10': 0.1} and code='  save10  ' also raises ValueError instead of returning 0.1, this hypothesis is wrong.",
        "possibly_intended": true,
        "id": "H2"
      },
      {
        "claim_id": "C0",
        "title": "Non-string code exception type changed",
        "changed_locations": [
          "src/demo_shop/cart.py::apply_coupon"
        ],
        "suspected_behavior": "With coupons={'save10': 0.1} and non-string code=None, base fails on code.strip().casefold() with AttributeError, while head performs dict membership check and raises ValueError instead.",
        "expected_base": "raises AttributeError from code.strip()",
        "expected_head": "raises ValueError for unknown coupon",
        "test_intent": "Call apply_coupon({'save10': 0.1}, None) on base and head and compare exception types.",
        "risk_category": "error-handling",
        "falsification_criteria": "If base with code=None does not raise AttributeError (e.g., also raises ValueError), this hypothesis is wrong.",
        "possibly_intended": false,
        "id": "H3"
      }
    ],
    "rejected": []
  },
