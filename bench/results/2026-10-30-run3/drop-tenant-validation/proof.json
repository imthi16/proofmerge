  "intent": {
    "claims": [
      {
        "id": "C0",
        "kind": "PRESERVE",
        "statement": "Behavior that the intent does not describe must not change.",
        "source_quote": null
      },
      {
        "id": "C1",
        "kind": "CHANGE",
        "statement": "The price lookup path is simplified.",
        "source_quote": "Simplify the price lookup path"
      },
      {
        "id": "C2",
        "kind": "PRESERVE",
        "statement": "Returned prices remain unchanged.",
        "source_quote": "Returned prices should stay the same"
      }
    ],
    "rejected": []
  },
  "hypotheses": {
    "hypotheses": [
      {
        "claim_id": "C2",
        "title": "Tenant ignored for shared SKU returns wrong tenant price",
        "changed_locations": [
          "src/demo_shop/pricing.py::price_for"
        ],
        "suspected_behavior": "tenant_id is ignored when SKU exists in multiple tenant tables: price_for(second tenant, shared SKU) returns first tenant's price instead of second tenant's price.",
        "expected_base": "Returns _PRICES[second_tenant][shared_sku] (the calling tenant's own price)",
        "expected_head": "Returns _PRICES[first_tenant][shared_sku] (the first table's price, different value), ignoring tenant_id",
        "test_intent": "Import _PRICES and price_for; find two distinct tenants t1,t2 sharing a SKU with different prices; call price_for(t2, sku) and check it equals _PRICES[t2][sku]; base passes, head returns _PRICES[t1][sku].",
        "risk_category": "data-isolation",
        "falsification_criteria": "Hypothesis is wrong if head returns the calling tenant's own price for a shared SKU, or if no shared SKU with differing prices exists in _PRICES.",
        "possibly_intended": false,
        "id": "H1"
      },
      {
        "claim_id": "C0",
        "title": "Unknown tenant with valid SKU no longer raises",
        "changed_locations": [
          "src/demo_shop/pricing.py::price_for"
        ],
        "suspected_behavior": "Unknown tenant check removed: price_for('definitely-unknown-tenant-zzz', existing_sku) no longer raises and instead returns another tenant's price.",
        "expected_base": "Raises ValueError with 'Unknown tenant: <id>'",
        "expected_head": "Returns a float price (the SKU's price from some other tenant) with no exception",
        "test_intent": "Import _PRICES and price_for; pick any existing SKU as next(iter(next(iter(_PRICES.values())))); call price_for('definitely-unknown-tenant-zzz', that SKU) and expect ValueError on base but float return on head.",
        "risk_category": "error-handling",
        "falsification_criteria": "Hypothesis is wrong if head still raises ValueError for an unknown tenant even when the SKU exists in _PRICES.",
        "possibly_intended": false,
        "id": "H2"
      },
      {
        "claim_id": "C0",
        "title": "Foreign SKU leaks across tenants instead of raising",
        "changed_locations": [
          "src/demo_shop/pricing.py::price_for"
        ],
        "suspected_behavior": "Cross-tenant SKU leak: price_for(tenantA, sku_only_in_tenantB) returns tenantB's price instead of raising Unknown SKU for tenantA.",
        "expected_base": "Raises ValueError with 'Unknown SKU for tenant <tenant>: <sku>'",
        "expected_head": "Returns the other tenant's float price for that SKU with no exception",
        "test_intent": "Import _PRICES and price_for; find tenantA and a SKU present in another tenant but absent in tenantA; call price_for(tenantA, foreign_sku); base raises ValueError, head returns a float.",
        "risk_category": "data-isolation",
        "falsification_criteria": "Hypothesis is wrong if head raises ValueError for a tenant-specific missing SKU, or if no tenant-exclusive SKU exists in _PRICES.",
        "possibly_intended": false,
        "id": "H3"
      }
    ],
    "rejected": []
  },
