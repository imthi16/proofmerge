    "hypotheses": [
      {
        "claim_id": "C0",
        "title": "Negative purchase corrupts ledger before raising",
        "changed_locations": [
          "src/demo_shop/orders.py::record_purchase"
        ],
        "suspected_behavior": "Calling record_purchase({'alice': 100.0}, 'alice', -10.0) mutates ledger to 90.0 before raising ValueError, corrupting balance",
        "expected_base": "Raises ValueError with 'Negative purchase amount' message and ledger['alice'] remains 100.0",
        "expected_head": "Raises ValueError with 'Negative purchase amount' message but ledger['alice'] becomes 90.0",
        "test_intent": "Create ledger {'alice': 100.0}, call record_purchase with amount -10.0 expecting ValueError, then assert ledger['alice'] is still 100.0",
        "risk_category": "state",
        "falsification_criteria": "If head leaves ledger['alice'] at 100.0 after raising on amount -10.0, this hypothesis is wrong.",
        "possibly_intended": false,
        "id": "H1"
      },
      {
        "claim_id": "C0",
        "title": "Error precedence flipped for unknown customer with negative amount",
        "changed_locations": [
          "src/demo_shop/orders.py::record_purchase"
        ],
        "suspected_behavior": "Calling record_purchase({}, 'bob', -5.0) with unknown customer and negative amount raises Unknown customer instead of Negative purchase amount",
        "expected_base": "Raises ValueError with message containing 'Negative purchase amount'",
        "expected_head": "Raises ValueError with message containing 'Unknown customer'",
        "test_intent": "Call record_purchase({}, 'bob', -5.0) and assert the ValueError message contains 'Negative purchase amount'",
        "risk_category": "error-handling",
        "falsification_criteria": "If head still raises 'Negative purchase amount' for unknown customer with negative amount, this hypothesis is wrong.",
        "possibly_intended": true,
        "id": "H2"
      }
    ],
    "rejected": []
  },
