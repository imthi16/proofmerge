        "statement": "Behavior that the intent does not describe must not change.",
        "source_quote": null
      }
    ],
    "rejected": []
  },
  "hypotheses": {
    "hypotheses": [
      {
        "claim_id": "C0",
        "title": "line_totals no longer subscriptable",
        "changed_locations": [
          "src/demo_shop/orders.py::line_totals"
        ],
        "suspected_behavior": "With items=[{'qty': 2, 'price': 10.0}], base returns a list so result[0] works, head returns a generator so result[0] raises TypeError.",
        "expected_base": "Returns [20.0] and line_totals(items)[0] == 20.0",
        "expected_head": "Raises TypeError: 'generator' object is not subscriptable when subscripting [0]",
        "test_intent": "Call line_totals([{'qty':2,'price':10.0}]) and subscript [0], assert it equals 20.0.",
        "risk_category": "interface",
        "falsification_criteria": "If head result supports subscripting and line_totals(items)[0] == 20.0, this hypothesis is wrong.",
        "possibly_intended": false,
        "id": "H1"
      },
      {
        "claim_id": "C0",
        "title": "line_totals result exhausts on reuse",
        "changed_locations": [
          "src/demo_shop/orders.py::line_totals"
        ],
        "suspected_behavior": "With items=[{'qty':2,'price':10.0},{'qty':1,'price':5.0}], saving result = line_totals(items) then list(result) twice yields full list twice on base but empty second time on head because generator exhausts.",
        "expected_base": "First list(result) == [20.0, 5.0] and second list(result) == [20.0, 5.0]",
        "expected_head": "First list(result) == [20.0, 5.0] and second list(result) == []",
        "test_intent": "Store result = line_totals(items), assert list(result)==[20.0,5.0] then assert list(result)==[20.0,5.0] again.",
        "risk_category": "state",
        "falsification_criteria": "If head result can be materialized to [20.0, 5.0] twice without exhaustion, this hypothesis is wrong.",
        "possibly_intended": false,
        "id": "H2"
      },
      {
        "claim_id": "C0",
        "title": "Empty order truthiness flips",
        "changed_locations": [
          "src/demo_shop/orders.py::line_totals"
        ],
        "suspected_behavior": "With items=[], base returns [] which is falsy, head returns a generator object which is always truthy, so empty-check flips.",
        "expected_base": "bool(line_totals([])) is False, so `not line_totals([])` is True",
        "expected_head": "bool(line_totals([])) is True, so `not line_totals([])` is False",
        "test_intent": "Call line_totals([]) and assert `not result` is True / bool(result) is False.",
        "risk_category": "boundary",
        "falsification_criteria": "If bool(line_totals([])) is False on head, this hypothesis is wrong.",
        "possibly_intended": false,
        "id": "H3"
      }
    ],
    "rejected": []
  },
