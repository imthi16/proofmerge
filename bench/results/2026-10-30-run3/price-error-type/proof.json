    "hypotheses": [
      {
        "claim_id": "C0",
        "title": "Unknown SKU exception type breaks ValueError callers",
        "changed_locations": [
          "src/demo_shop/pricing.py::price_for"
        ],
        "suspected_behavior": "price_for with a valid tenant_id and an unknown sku (e.g., valid tenant from _PRICES with sku '__missing-sku__') no longer raises ValueError, so existing callers doing `except ValueError` will miss it and it will propagate as unhandled LookupError.",
        "expected_base": "raises ValueError with message 'Unknown SKU for tenant ...' ",
        "expected_head": "raises LookupError with same message (not caught by `except ValueError`)",
        "test_intent": "Get a valid tenant as next(iter(_PRICES)), call price_for(tenant, '__missing-sku-123__') and assert it raises ValueError; passes on base, fails on head which raises LookupError.",
        "risk_category": "error-handling",
        "falsification_criteria": "Falsified if head still raises ValueError (or a subclass of ValueError) for unknown SKU, or if `except ValueError` still catches head's exception.",
        "possibly_intended": true,
        "id": "H1"
      }
    ],
    "rejected": []
  },
