  "hypotheses": {
    "hypotheses": [
      {
        "claim_id": "C0",
        "title": "Unknown tenant silently returns 0.0 instead of raising",
        "changed_locations": [
          "src/demo_shop/pricing.py::price_for"
        ],
        "suspected_behavior": "price_for with unknown tenant e.g. price_for('no-such-tenant', 'widget') no longer raises ValueError but silently returns 0.0",
        "expected_base": "raises ValueError with message 'Unknown tenant: ...'",
        "expected_head": "returns 0.0",
        "test_intent": "Call price_for with a tenant_id not in _PRICES and assert it raises ValueError; fails on head which returns 0.0.",
        "risk_category": "error-handling",
        "falsification_criteria": "If base for an unknown tenant ID also returns 0.0, or head still raises ValueError, this hypothesis is wrong.",
        "possibly_intended": false,
        "id": "H1"
      },
      {
        "claim_id": "C0",
        "title": "Unknown SKU for known tenant silently returns 0.0 instead of raising",
        "changed_locations": [
          "src/demo_shop/pricing.py::price_for"
        ],
        "suspected_behavior": "price_for with known tenant but unknown sku e.g. price_for(valid_tenant, 'no-such-sku') no longer raises ValueError but silently returns 0.0",
        "expected_base": "raises ValueError with message 'Unknown SKU for tenant ...'",
        "expected_head": "returns 0.0",
        "test_intent": "Call price_for with a valid tenant_id and a sku not in its table and assert it raises ValueError; fails on head which returns 0.0.",
        "risk_category": "error-handling",
        "falsification_criteria": "If base for a known tenant with unknown SKU also returns 0.0, or head still raises ValueError, this hypothesis is wrong.",
        "possibly_intended": false,
        "id": "H2"
      }
    ],
    "rejected": []
  },
