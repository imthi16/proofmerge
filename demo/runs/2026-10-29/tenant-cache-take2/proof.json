  "hypotheses": {
    "hypotheses": [
      {
        "claim_id": "C0",
        "title": "Cached SKU bypasses unknown-tenant check",
        "changed_locations": [
          "src/demo_shop/pricing.py::price_for"
        ],
        "suspected_behavior": "After price_for('tenant-b','widget') caches sku 'widget', price_for('no-such-tenant','widget') returns the cached price instead of raising ValueError, because cache key is sku-only and checked before tenant validation.",
        "expected_base": "ValueError('Unknown tenant: no-such-tenant') on the second call - base checks tenant_id first and is stateless",
        "expected_head": "35.0 on the second call - early `if sku in _price_cache: return` returns cached tenant-b price before tenant validation",
        "test_intent": "Call price_for('tenant-b','widget') to prime cache, then with pytest.raises(ValueError) call price_for('no-such-tenant','widget') with same sku; fails on head if it returns a float.",
        "risk_category": "error-handling",
        "falsification_criteria": "If head raises ValueError for unknown tenant with sku 'widget' after priming the cache with price_for('tenant-b','widget'), this hypothesis is wrong.",
        "possibly_intended": false,
        "id": "H1"
      },
      {
        "claim_id": "C2",
        "title": "Price update ignored after caching - stale return",
        "changed_locations": [
          "src/demo_shop/pricing.py::price_for"
        ],
        "suspected_behavior": "Once price_for('tenant-b','widget') is called, later change to _PRICES['tenant-b']['widget'] (e.g. to 99.0) is ignored and stale 35.0 is returned.",
        "expected_base": "99.0 on second call - base does `return table[sku]` fresh from _PRICES every time",
        "expected_head": "35.0 on second call - first call stored `_price_cache['widget']=35.0` and second call early-returns it ignoring table update",
        "test_intent": "Call price_for('tenant-b','widget'), then set _PRICES['tenant-b']['widget']=99.0 (restore in finally), call price_for('tenant-b','widget') again and assert result equals 99.0.",
        "risk_category": "state",
        "falsification_criteria": "If head returns the updated 99.0 price after _PRICES mutation, this hypothesis is wrong.",
        "possibly_intended": false,
        "id": "H2"
      }
    ],
    "rejected": []
  },
