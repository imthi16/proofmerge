  },
  "hypotheses": {
    "hypotheses": [
      {
        "claim_id": "C3",
        "title": "Per-category cap replaces per-expense cap",
        "changed_locations": [
          "src/expenses/totals.ts::reimbursableCents"
        ],
        "suspected_behavior": "Head caps the summed category total instead of capping each expense: two submitted expenses in same category each with amountCents=CAP returns 2*CAP on base but CAP on head.",
        "expected_base": "2*CAP (sum of per-expense mins, e.g. two submitted expenses at exactly CAP each returns 2*CAP)",
        "expected_head": "1*CAP (per-category sum capped once, i.e. min(2*CAP,CAP)=CAP)",
        "test_intent": "Import reimbursableCents and CATEGORY_CAP_CENTS, pick any category CAP, call with two submitted expenses same category each amountCents=CAP, compare base vs head totals.",
        "risk_category": "logic",
        "falsification_criteria": "Head returns the same total as base (2*CAP) for two same-category submitted/approved expenses each at CAP.",
        "possibly_intended": false,
        "id": "H1"
      },
      {
        "claim_id": "C3",
        "title": "Draft expenses now counted as payable",
        "changed_locations": [
          "src/expenses/totals.ts::reimbursableCents"
        ],
        "suspected_behavior": "Head uses status!=='rejected' so a draft expense with amountCents=1 is counted, while base skipped all non-submitted/approved so returned 0.",
        "expected_base": "0 (draft is skipped)",
        "expected_head": "1 (or min(1,CAP) >0, draft is counted as payable)",
        "test_intent": "Call reimbursableCents with single draft expense amountCents=1 in any category and check returned total on base vs head.",
        "risk_category": "state",
        "falsification_criteria": "Head returns 0 for a lone draft expense, same as base.",
        "possibly_intended": false,
        "id": "H2"
      },
      {
        "claim_id": "C4",
        "title": "Negative draft now throws instead of ignored",
        "changed_locations": [
          "src/expenses/totals.ts::reimbursableCents"
        ],
        "suspected_behavior": "Head validates negatives for all non-rejected including draft, so a draft with amountCents=-5 throws, while base ignored draft negatives.",
        "expected_base": "returns 0 with no throw (negative draft ignored)",
        "expected_head": "throws RangeError for the draft id",
        "test_intent": "Call reimbursableCents with single draft expense amountCents negative and observe return vs RangeError throw on base vs head.",
        "risk_category": "error-handling",
        "falsification_criteria": "Head does not throw for a negative-amount draft expense, matching base.",
        "possibly_intended": false,
        "id": "H3"
      }
    ],
    "rejected": []
  },
